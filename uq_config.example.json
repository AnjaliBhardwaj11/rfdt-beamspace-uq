      "images_per_tx": 200,
      "views_per_rx": 4,
      "train_tx_max": 2,
      "train_rx_max": 40
    }
  },
  "uq": {
    "rx_std_xyz_m": [0.02, 0.02, 0.01],
    "mean_mode_std_m": 0.01,
    "sh_mode_std_frac": 0.08,
    "alpha_mode_std_frac": 0.06,
    "scale_mode_std_frac": 0.05,
    "dir_std_rad": 0.08,
    "smooth_std": 0.1,
    "drop_prob": 0.1,
    "drop_width_frac": 0.1,
