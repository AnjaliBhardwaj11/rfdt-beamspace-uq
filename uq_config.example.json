{
  "forward": {
    "ply_path": "/absolute/path/to/point_cloud.ply",
    "freq_hz": 3500000000.0,
    "tx_pos_m": [3.5, 2.5, 2.7],
    "sh_order": 3,
    "gaussian_chunk": 32768,
    "rx_grid": {
      "x_min": 0.3,
